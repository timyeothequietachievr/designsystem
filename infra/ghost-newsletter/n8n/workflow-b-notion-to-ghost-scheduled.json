    {
      "parameters": {
        "jsCode": "/* Paste full file from infra/ghost-newsletter/scripts/notion-blocks-to-html.js */\nconst blocks = $input.first().json.results ?? [];\nfunction richTextToHtml(richText = []) {\n  return richText.map((t) => {\n    let s = (t.plain_text ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\n    if (t.annotations?.bold) s = `<strong>${s}</strong>`;\n    if (t.annotations?.italic) s = `<em>${s}</em>`;\n    if (t.href) s = `<a href=\"${t.href}\">${s}</a>`;\n    return s;\n  }).join('');\n}\nfunction blockToHtml(block) {\n  const type = block.type;\n  const data = block[type] ?? {};\n  if (type === 'paragraph') return `<p>${richTextToHtml(data.rich_text)}</p>`;\n  if (type === 'heading_1') return `<h1>${richTextToHtml(data.rich_text)}</h1>`;\n  if (type === 'heading_2') return `<h2>${richTextToHtml(data.rich_text)}</h2>`;\n  if (type === 'heading_3') return `<h3>${richTextToHtml(data.rich_text)}</h3>`;\n  if (type === 'quote') return `<blockquote>${richTextToHtml(data.rich_text)}</blockquote>`;\n  if (type === 'divider') return '<hr />';\n  if (type === 'image') {\n    const url = data.file?.external?.url ?? data.file?.file?.url;\n    return url ? `<figure><img src=\"${url}\" alt=\"\" /></figure>` : '';\n  }\n  return '';\n}\nconst html = blocks.map(blockToHtml).filter(Boolean).join('\\n');\nconst page = $('Each row').item.json;\nconst title = page.property_content_title ?? page.name ?? 'Newsletter';\nconst publishStart = page.property_publish_date_newsletter?.start ?? page['Publish Date Newsletter'];\nreturn [{ json: { html, title, publishStart, pageId: page.id } }];"
      },
      "id": "b5-html",
      "name": "Blocks to HTML",
      "type": "n8n-nodes-base.code",
